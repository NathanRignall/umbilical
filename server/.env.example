# Address the portal listens on. UniFi redirects guests to http://<portal-ip>/guest/s/<site>/,
# so in production this must be port 80.
LISTEN_ADDR=0.0.0.0:80
# Built frontend (npm run build in ../web).
STATIC_DIR=../web/dist

# Your UniFi OS console (UDM / UCG / Cloud Key Gen2+). The integration API lives at
# <UNIFI_URL>/proxy/network/integration. For a self-hosted Network Application,
# set UNIFI_API_BASE to the full integration base URL instead.
UNIFI_URL=https://192.168.1.1
# UNIFI_API_BASE=https://unifi.example.lan:8443/integration
UNIFI_API_KEY=
# Consoles use a self-signed certificate out of the box.
UNIFI_INSECURE_TLS=true

# Access granted per guest. Leave the optional limits blank for unlimited.
GUEST_MINUTES=1440
GUEST_DATA_LIMIT_MB=
GUEST_RX_KBPS=
GUEST_TX_KBPS=

# Set to 1 to fake authorizations (UI work without a controller).
UNIFI_MOCK=
